# Docker Compose reads this file after copying it to .env.
# Run Docker on the Linux Edge PC. All runtime and device settings live in this file.
DEVICE_SIMULATOR_CONTAINER_NAME=ethercat-device-simulator
KICKCAT_INTERFACE=enp1s0
DEVICE_SIMULATOR_STATE_DIR=./state
# Copley and analog-delay FMUs are compiled into the Docker image; the pinned cylinder FMU is packaged intact.
# Optional external FMU override (scripts/docker select the additional compose file):
# DEVICE_SIMULATOR_FMU_DIR=./model_artifacts
DEVICE_SIMULATOR_CYCLE_STATS_LOGS=1
# 0 = no execution time limit. A positive limit is for diagnostics only.
DEVICE_SIMULATOR_SESSION_TIMEOUT=0
# RPC deadline in ms (10..5000). Expiry latches Host Fault; manual restart required.
DEVICE_SIMULATOR_MODEL_TIMEOUT_MS=100
# Defaults to a UTC timestamp if empty; letters, digits, _ and - only.
DEVICE_SIMULATOR_RUN_ID=

# Explicit EtherCAT slave order, then stable axis identity and model settings.
DEVICE_SIMULATOR_BUS=0:axis:cia402-drive,1:axis:cia402-drive,2:axis:cia402-drive,3:axis:cia402-drive
# Unique axis names. The number on the left is the Simulator-local Slave index.
# Each name selects state/<name>.json and the corresponding PDO mapping store.
# Keep names unchanged when reordering the bus. Renaming creates a new device identity;
# existing saved parameters and PDO mappings are not migrated automatically.
DEVICE_SIMULATOR_AXIS_NAMES=0: virtual-axis-0, 1: virtual-axis-1, 2: virtual-axis-2, 3: virtual-axis-3
DEVICE_SIMULATOR_AXIS_MODELS=0: f_kr_cmmt, 1: f_kr_cmmt, 2: f_kr_cmmt, 3: f_kr_cmmt
DEVICE_SIMULATOR_AXIS_MODES=0: linear, 1: linear, 2: rotary, 3: rotary

# Parameters use state/<axis ID>.json; PDO mappings use the same ID in pdo-mappings/.
# Copley example: use a new axis ID if changing model type; incompatible stored files are rejected.
# DEVICE_SIMULATOR_AXIS_MODELS=0: copley_drive_sim, 1: f_kr_cmmt, 2: f_kr_cmmt, 3: f_kr_cmmt

# RF-013: optional CPX topology (replace BUS, do not append a second BUS key).
# Axis mapping lists contain only axis slave indices in a mixed bus.
# For an IO-only bus, remove/comment all DEVICE_SIMULATOR_AXIS_* lists above.
# DEVICE_SIMULATOR_BUS=0:io:cpx_ap_i_ec:io0
# DEVICE_SIMULATOR_IO_io0_MODULES=1:DI:8,2:DO:8,3:AIO:4:4
# Unbound DI/AI remain zero. No product loopback is enabled.
# Built-in real FMI 3.0 models; model_presets supplies geometry/delay configuration.
# DEVICE_SIMULATOR_IO_MODELS=cylinder0:cylinder_100mm,analog0:analog_delay_16ms
# Per-instance operating and initial conditions; prefix each group with its instance name.
# DEVICE_SIMULATOR_IO_MODEL_INSTANCES=cylinder0: supply_gauge_pressure:600000,initial_position:0
# DEVICE_SIMULATOR_IO_io0_BINDINGS=2:DO:0=cylinder0.extend,2:DO:1=cylinder0.retract,1:DI:0=cylinder0.retracted,1:DI:1=cylinder0.extended,3:AO:0=analog0.command,3:AI:0=analog0.feedback

# Example identity change for a new Copley device (also selects a new PDO mapping store):
# DEVICE_SIMULATOR_AXIS_NAMES=0: copley-axis-0, 1: virtual-axis-1, 2: virtual-axis-2, 3: virtual-axis-3
