# Docker Compose reads this file after copying it to .env.
# Run Docker on the Linux Edge PC. All runtime and device settings live in this file.
DEVICE_SIMULATOR_CONTAINER_NAME=ethercat-device-simulator
KICKCAT_INTERFACE=enp1s0
DEVICE_SIMULATOR_STATE_DIR=./state
DEVICE_SIMULATOR_CYCLE_STATS_LOGS=1
# 0 = no execution time limit. A positive limit is for diagnostics only.
DEVICE_SIMULATOR_SESSION_TIMEOUT=0
# Defaults to a UTC timestamp if empty; letters, digits, _ and - only.
DEVICE_SIMULATOR_RUN_ID=

# Explicit EtherCAT slave order, then stable axis identity and model settings.
DEVICE_SIMULATOR_BUS=0:axis:cmmt-as,1:axis:cmmt-as,2:axis:cmmt-as,3:axis:cmmt-as
DEVICE_SIMULATOR_AXIS_IDS=0: virtual-axis-0, 1: virtual-axis-1, 2: virtual-axis-2, 3: virtual-axis-3
DEVICE_SIMULATOR_AXIS_MODELS=0: f_kr_internal, 1: f_kr_internal, 2: f_kr_internal, 3: f_kr_internal
DEVICE_SIMULATOR_AXIS_MODES=0: linear, 1: linear, 2: rotary, 3: rotary
DEVICE_SIMULATOR_AXIS_PARAMETER_SETS=0: axis-0, 1: axis-1, 2: axis-2, 3: axis-3
