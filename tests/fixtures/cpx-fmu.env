# RF-013 real FMU fixture, separate from production .env/state.
KICKCAT_INTERFACE=enp1s0
DEVICE_SIMULATOR_STATE_DIR=./state
DEVICE_SIMULATOR_BUS=0:io:cpx_ap_i_ec:io0,1:io:cpx_ap_i_ec:io1
DEVICE_SIMULATOR_IO_io0_MODULES=1:DI:8,2:DO:8,3:AIO:4:4
DEVICE_SIMULATOR_IO_io1_MODULES=1:DI:8,2:DO:8,3:AIO:4:4
DEVICE_SIMULATOR_BEHAVIOUR_MODELS=cylinder0:cylinder_100mm,cylinder1:cylinder_100mm,analog0:analog_delay_16ms,analog1:analog_delay_16ms
DEVICE_SIMULATOR_MODEL_cylinder0_INSTANCE_CONFIG=supply_gauge_pressure:600000,initial_position:0
DEVICE_SIMULATOR_MODEL_cylinder1_INSTANCE_CONFIG=supply_gauge_pressure:600000,initial_position:0
DEVICE_SIMULATOR_IO_io0_BINDINGS=2:DO:0=cylinder0.extend,2:DO:1=cylinder1.retract,1:DI:0=cylinder0.extended,1:DI:1=cylinder1.retracted,3:AO:0=analog0.command,3:AI:1=analog1.feedback
DEVICE_SIMULATOR_IO_io1_BINDINGS=2:DO:0=cylinder0.retract,2:DO:1=cylinder1.extend,1:DI:0=cylinder0.retracted,1:DI:1=cylinder1.extended,3:AO:1=analog1.command,3:AI:0=analog0.feedback
